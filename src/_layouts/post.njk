---
layout: base.njk

---

<article class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl">
    <!-- Breadcrumbs -->
    <nav
      aria-label="Breadcrumb"
      class="mb-6 flex items-center gap-2 text-xs font-mono text-neutral-500 dark:text-neutral-400"
    >
      <a href="/" class="hover:text-black dark:hover:text-white transition">Home</a>
      <span class="text-neutral-300 dark:text-neutral-700">/</span>
      <a href="/blog/" class="hover:text-black dark:hover:text-white transition">Blog</a>
      <span class="text-neutral-300 dark:text-neutral-700">/</span>
      <span
        class="text-neutral-800 dark:text-white font-semibold truncate max-w-50 sm:max-w-xs"
      >{{ title }}</span>
    </nav>

    <!-- Back to blog navigation -->
    <div class="mb-8">
      <a
        href="/blog/"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition group"
      >
        <svg
          class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to all articles</span>
      </a>
    </div>

    <header class="mb-10 pb-8 border-b border-neutral-200 dark:border-neutral-800">
      <!-- Meta info -->
      <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-4">
        <time datetime="{{ date }}">{{ date | postDate }}</time>
        <svg class="w-1.5 h-1.5 fill-neutral-400 dark:fill-neutral-600" viewBox="0 0 6 6">
          <circle cx="3" cy="3" r="3" />
        </svg>
        <div class="flex flex-wrap gap-1.5">
          {% for tag in tags %}
            {% if tag != "blog" and tag != "all" %}
              <span
                class="rounded bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 text-neutral-700 dark:text-neutral-300"
              >#{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <h1 class="font-heading text-5xl sm:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white leading-tight">
        {{ title }}
      </h1>

      {% if description %}
        <p class="mt-4 text-xl text-neutral-600 dark:text-neutral-400 font-sans leading-relaxed">
          {{ description }}
        </p>
      {% endif %}

      {% if image %}
        <div class="mt-8 overflow-hidden rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 shadow-sm">
          <img
            src="{{ image }}"
            alt="{{ title }}"
            class="w-full h-auto object-cover max-h-500px"
            loading="eager"
          />
        </div>
      {% endif %}
    </header>

    <!-- Article Markdown Content -->
    <div class="prose-content space-y-6 text-neutral-800 dark:text-neutral-200 font-sans leading-relaxed text-base sm:text-lg">
      {{ content | safe }}
    </div>

    <!-- Author Bio Footer inside Post -->
    <div class="mt-16 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <img
          src="/assets/uploads/profile.webp"
          alt="{{ site.name }}"
          class="w-12 h-12 rounded-full border border-neutral-300 dark:border-neutral-700 object-cover"
        />
        <div>
          <p class="font-heading text-lg font-bold text-neutral-900 dark:text-white leading-none">
            Written by {{ site.name }}
          </p>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 font-mono mt-1">{{ site.role }}</p>
        </div>
      </div>
      <a
        href="/blog/"
        class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-200 hover:text-neutral-600 dark:hover:text-white group"
      >
        <span>More articles</span>
        <svg
          class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</article>
