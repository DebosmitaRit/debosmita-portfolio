---
layout: base.njk

---

<article class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl">
    <!-- Breadcrumbs -->
    <nav
      aria-label="Breadcrumb"
      class="mb-6 flex items-center gap-2 text-xs font-mono text-neutral-500 dark:text-neutral-400"
    >
      <a href="/" class="hover:text-black dark:hover:text-white transition">Home</a>
      <span class="text-neutral-300 dark:text-neutral-700">/</span>
      <a href="/portfolio/" class="hover:text-black dark:hover:text-white transition">Portfolio</a>
      <span class="text-neutral-300 dark:text-neutral-700">/</span>
      <span
        class="text-neutral-800 dark:text-white font-semibold truncate max-w-50 sm:max-w-xs"
      >{{ title }}</span>
    </nav>

    <!-- Back to portfolio -->
    <div class="mb-8">
      <a
        href="/portfolio/"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition group"
      >
        <svg
          class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to all projects</span>
      </a>
    </div>

    <header class="mb-12">
      <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-4">
        <time datetime="{{ date }}" class="tabular-nums">{{ date | postDate }}</time>
        {% if client %}
          <svg class="w-1.5 h-1.5 fill-neutral-400 dark:fill-neutral-600" viewBox="0 0 6 6">
            <circle cx="3" cy="3" r="3" />
          </svg>
          <span class="font-semibold text-neutral-800 dark:text-neutral-200">{{ client }}</span>
        {% endif %}
      </div>

      <h1 class="font-heading text-5xl sm:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white leading-tight">
        {{ title }}
      </h1>

      {% if summary %}
        <p class="mt-6 text-xl sm:text-2xl text-neutral-600 dark:text-neutral-400 font-sans leading-relaxed">
          {{ summary }}
        </p>
      {% endif %}

      <!-- Project Metadata Bar -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-2xs">
        {% if role %}
          <div>
            <span
              class="block font-mono text-[11px] uppercase tracking-wider text-neutral-400 dark:text-neutral-500"
            >Role</span>
            <span class="block text-sm font-semibold text-neutral-900 dark:text-white mt-1">{{
              role
            }}</span>
          </div>
        {% endif %}

        {% if client %}
          <div>
            <span
              class="block font-mono text-[11px] uppercase tracking-wider text-neutral-400 dark:text-neutral-500"
            >Client / Context</span>
            <span class="block text-sm font-semibold text-neutral-900 dark:text-white mt-1">{{
              client
            }}</span>
          </div>
        {% endif %}

        <div>
          <span
            class="block font-mono text-[11px] uppercase tracking-wider text-neutral-400 dark:text-neutral-500"
          >Timeline</span>
          <span class="block text-sm font-semibold text-neutral-900 dark:text-white mt-1">{{
            date | postDate
          }}</span>
        </div>

        <div class="flex items-center gap-2.5">
          {% if liveUrl %}
            <a
              href="{{ liveUrl }}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 justify-center rounded-lg bg-neutral-950 dark:bg-white px-3.5 py-2 text-xs font-medium text-white dark:text-neutral-950 shadow-xs hover:bg-neutral-800 dark:hover:bg-neutral-200 transition"
            >
              <span>Live Demo</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path
                  fill-rule="evenodd"
                  d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h4a.75.75 0 010 1.5h-4z"
                  clip-rule="evenodd"
                />
                <path
                  fill-rule="evenodd"
                  d="M6.194 12.753a.75.75 0 001.06 1.06L16.24 4.825V8.25a.75.75 0 001.5 0V3a.75.75 0 00-.75-.75h-5.25a.75.75 0 000 1.5h3.425L6.194 12.753z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          {% endif %}
          {% if githubUrl %}
            <a
              href="{{ githubUrl }}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 justify-center rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-800 px-3.5 py-2 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-700 hover:text-black dark:hover:text-white transition"
            >
              <svg
                class="w-3.5 h-3.5 text-neutral-700 dark:text-neutral-300"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                />
              </svg>
              <span>Source</span>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Featured Hero Image -->
      {% if image %}
        <div class="mt-10 overflow-hidden rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-950 shadow-md">
          <img
            src="{{ image }}"
            alt="{{ title }}"
            class="w-full h-auto object-cover"
            loading="eager"
          />
        </div>
      {% endif %}
    </header>

    <!-- Case study content -->
    <div class="prose-content space-y-6 text-neutral-800 dark:text-neutral-200 font-sans leading-relaxed text-base sm:text-lg border-t border-neutral-200 dark:border-neutral-800 pt-10">
      {{ content | safe }}
    </div>

    <!-- Footer navigation between projects -->
    <div class="mt-16 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex justify-between items-center">
      <a
        href="/portfolio/"
        class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-neutral-800 dark:text-neutral-200 hover:text-black dark:hover:text-white group"
      >
        <svg
          class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>View all case studies</span>
      </a>
    </div>
  </div>
</article>
