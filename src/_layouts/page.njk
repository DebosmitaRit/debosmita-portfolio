---
layout: base.njk
---

<article class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs font-mono text-neutral-500 dark:text-neutral-400">
    <a href="/" class="hover:text-black dark:hover:text-white transition">Home</a>
    <span class="text-neutral-300 dark:text-neutral-700">/</span>
    <span class="text-neutral-800 dark:text-white font-semibold">{{ title }}</span>
  </nav>

  <header class="mb-10 pb-8 border-b border-neutral-200 dark:border-neutral-800">
    <h1 class="font-heading text-5xl sm:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white">{{ title }}</h1>
    {% if description %}
    <p class="mt-4 text-xl text-neutral-600 dark:text-neutral-400 font-sans leading-relaxed">{{ description }}</p>
    {% endif %}
  </header>

  <div class="prose-content max-w-none text-neutral-800 dark:text-neutral-200 font-sans leading-relaxed text-base sm:text-lg space-y-6">
    {{ content | safe }}
  </div>
</article>
