<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="{{ eleventy.generator }}" />

    <!-- SEO Titles, Meta Descriptions & Canonical URLs -->
    {% set pageTitle %}{% if title %}{{ title }} | {% endif %}{{ site.name }}{% endset %}
    {% set pageDescription = description or site.description %}
    {% set canonicalUrl %}{{ site.url }}{{ page.url }}{% endset %}
    {% set ogImage %}{% if image %}{{ site.url }}{{ image }}{% else %}{{ site.url }}{{ site.image }}{% endif %}{% endset %}

    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    {% if site.keywords %}<meta name="keywords" content="{{ site.keywords }}" />{% endif %}
    <meta name="author" content="{{ site.name }}" />
    <link rel="canonical" href="{{ canonicalUrl }}" />

    <!-- Search Engine Indexing & Bot Directives (Google & Bing) -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Search Console & Webmaster Verification -->
    {% if site.googleSiteVerification %}<meta name="google-site-verification" content="{{ site.googleSiteVerification }}" />{% endif %}
    {% if site.bingSiteVerification %}<meta name="msvalidate.01" content="{{ site.bingSiteVerification }}" />{% endif %}

    <!-- Open Graph (Facebook, LinkedIn, Pinterest, Discord) -->
    <meta property="og:type" content="{% if layout == 'post.njk' or layout == 'project.njk' %}article{% else %}website{% endif %}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:url" content="{{ canonicalUrl }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="{{ site.locale or 'en_US' }}" />
    <meta property="og:image" content="{{ ogImage }}" />
    <meta property="og:image:alt" content="{{ pageTitle }}" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />
    <meta name="twitter:image" content="{{ ogImage }}" />
    <meta name="twitter:site" content="{{ site.twitterHandle or '@DebosmitaRit' }}" />
    <meta name="twitter:creator" content="{{ site.twitterHandle or '@DebosmitaRit' }}" />

    <!-- Schema.org JSON-LD Structured Data for Rich Snippets (Google & Bing) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "{{ site.url }}/#website",
          "url": "{{ site.url }}/",
          "name": "{{ site.name }}",
          "description": "{{ site.description }}",
          "inLanguage": "en-US"
        },
        {
          "@type": "Person",
          "@id": "{{ site.url }}/#person",
          "name": "{{ site.name }}",
          "url": "{{ site.url }}",
          "image": "{{ site.url }}{{ site.image }}",
          "description": "{{ site.description }}",
          "jobTitle": "{{ site.role }}",
          "affiliation": {
            "@type": "CollegeOrUniversity",
            "name": "Techno India (Hooghly Campus), MAKAUT"
          },
          "knowsAbout": [
            "Python",
            "Java",
            "Cloud Computing",
            "Amazon Web Services (AWS)",
            "SAP S/4HANA",
            "Relational Databases",
            "SQL",
            "Cisco Networking"
          ],
          "sameAs": [
            "{{ site.github }}",
            "{{ site.linkedin }}",
            "{{ site.twitter }}"
          ]
        }
      ]
    }
    </script>

    <!-- Favicon (DR Monogram) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate icon"
      type="image/svg+xml"
      href="/assets/favicon.svg"
    />

    <!-- Google Fonts Preconnect & Preload: BenchNine (Headings), Inter (Body), Geist Mono (Code/Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=BenchNine:wght@300;400;700&family=Geist+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=BenchNine:wght@300;400;700&family=Geist+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
    />

    <!-- Font Preload Gate: Ensures fonts are fully loaded before rendering the page -->
    <style>
/* Hold page visibility until fonts are ready (zero flash of unstyled text / layout shifts) */
html.fonts-loading body {
  opacity: 0;
  visibility: hidden;
}
html.fonts-loaded body {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

</style>
    <script>
    (function() {
  document.documentElement.classList.add("fonts-loading");
  if ("fonts" in document) {
    Promise.race([
      document.fonts.ready,
      new Promise(function(resolve) {
        setTimeout(resolve, 800);
      }),
    ]).then(function() {
      document.documentElement.classList.remove("fonts-loading");
      document.documentElement.classList.add("fonts-loaded");
    });
  } else {
    document.documentElement.classList.remove("fonts-loading");
    document.documentElement.classList.add("fonts-loaded");
  }
})();
    </script>
    <noscript>
      <style>
html.fonts-loading body {
  opacity: 1 !important;
  visibility: visible !important;
}

</style>
    </noscript>

    <!-- Compiled Tailwind CSS v4 & Prism Syntax Highlighter Theme -->
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="stylesheet" href="/css/prism.css" />

    <!-- GSAP Animation Library -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>

    <!-- Alpine.js Plugins & Core (Pines UI requirement) -->
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/@alpinejs/focus@3.x.x/dist/cdn.min.js"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
    ></script>
    <!-- Dark Mode Theme Init: Prevents flash of unstyled theme on page load -->
    <script>
      (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50 dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 antialiased font-sans selection:bg-neutral-900 selection:text-white dark:selection:bg-white dark:selection:text-neutral-950 transition-colors duration-200">
    {% include "components/navigation-menu.njk" %}

    {% if draft or (page.url == '/' and home.draft) or (page.url == '/about/' and about.draft) or (page.url == '/resume/' and resume.draft) or (page.url == '/portfolio/' and portfolioPage.draft) or (page.url == '/blog/' and blogPage.draft) %}
    <aside aria-label="Draft Notice" class="bg-amber-500/15 border-b border-amber-500/30 text-amber-950 dark:text-amber-200 py-2.5 px-4 text-xs font-mono">
      <div class="mx-auto max-w-7xl flex items-center justify-between gap-4">
        <span class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
          <strong>DRAFT MODE</strong> &mdash; This {% if layout == 'post.njk' %}article{% elif layout == 'project.njk' %}project{% else %}page{% endif %} is currently saved as a draft in admin.
        </span>
        <span class="px-2 py-0.5 rounded bg-amber-200/80 dark:bg-amber-900/60 text-[10px] uppercase font-bold shrink-0">Draft</span>
      </div>
    </aside>
    {% endif %}

    <main class="flex-1">
      {{ content | safe }}
    </main>

    <footer class="border-t border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950 py-14 transition-colors duration-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-6">
          <div class="text-center md:text-left">
            <p class="font-heading text-2xl font-bold text-neutral-900 dark:text-white leading-none">
              {{ site.name }}
            </p>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 font-mono mt-1.5">
              {{ site.role }}
            </p>
          </div>

          <!-- Social Links in Footer (Centered) -->
          <div class="flex items-center justify-center gap-2.5 text-neutral-500 flex-wrap">
            {% for item in links.items %}
              {% if item.showInFooter !== false %}
              <a
                href="{{ item.url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="{{ item.title }}"
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white hover:border-neutral-400 dark:hover:border-neutral-700 transition shadow-2xs"
              >
                {% if item.icon == 'github' %}
                  <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
                {% elif item.icon == 'linkedin' %}
                  <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37h2.8V10.9h-2.8M7.86 6.54a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28Z" /></svg>
                {% elif item.icon == 'twitter' %}
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                {% elif item.icon == 'credly' %}
                  <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor"><path d="M23.8 13.154a.299.299 0 0 0-.101-.024.407.407 0 0 0-.202.048c-.06.028-.092.08-.127.136-.087.128-.15.268-.226.4-.107.187-.246.351-.38.515-.135.156-.286.291-.424.44-.028.027-.072.043-.107.027-.028-.016-.036-.056-.032-.088.04-.38.075-.763.123-1.138.02-.172.043-.336.063-.512.028-.247.056-.487.087-.735l.234-1.824c.02-.128.032-.372-.135-.52a.446.446 0 0 0-.233-.116.46.46 0 0 0-.254.06c-.226.16-.297.504-.365.76-.142.603-.178 1.241-.471 1.804a1.772 1.772 0 0 1-.202.316.668.668 0 0 1-.186.18.332.332 0 0 1-.246.051.365.365 0 0 1-.238-.207.871.87 0 0 1-.063-.324 4.499 4.499 0 0 1 .24-1.585c.045-.132.089-.252.104-.383.028-.156.028-.38-.114-.516-.131-.128-.337-.18-.504-.128-.194.056-.31.244-.372.392-.198.463-.25.95-.317 1.446-.044.327-.127.64-.293.926a2.717 2.717 0 0 1-.603.72c-.118.087-.222.123-.328.107a.376.376 0 0 1-.278-.208.875.875 0 0 1-.095-.315 3.361 3.36 0 0 1-.036-.616c.004-.223 0-.44.044-.658.075-.39.678-1.937.808-2.345.135-.407.262-.823.353-1.246.08-.38.123-.767.11-1.15-.007-.277-.07-.576-.288-.736a.611.61 0 0 0-.603-.048.968.968 0 0 0-.455.428 2.53 2.53 0 0 0-.226.59 12.01 12.01 0 0 0-.266 1.29c-.071.429-.138.848-.206 1.268-.06.355-.206 1.614-.261 1.88-.06.272-.175.54-.301.787-.131.268-.258.536-.408.791a.694.694 0 0 1-.175.224c-.08.06-.182.088-.27.048-.102-.048-.146-.176-.166-.292-.075-.435-.012-.875.072-1.302.083-.431.44-2.4.519-2.851.099-.532.24-1.05.285-1.59.028-.388.09-.88-.202-1.187-.115-.136-.31-.16-.44-.136-.174.036-.31.176-.388.296-.1.128-.186.28-.258.467-.115.284-.186.615-.261.91l-.032.129c-.083.383-.143.77-.186 1.162a16.95 16.948 0 0 0-.06.632c-.008.1-.016.203-.027.307 0 .08.007.168-.028.244a.304.304 0 0 1-.052.068c-.08.072-.202.06-.31.056-.557-.016-1.045.3-1.35.755-.18.252-.281.542-.39.834-.01.048-.034.1-.054.152-.051.143-.13.327-.222.511a3.037 3.037 0 0 1-.317.46 3.285 3.285 0 0 1-.384.41 1.123 1.123 0 0 1-.515.26c-.174.04-.384-.043-.543-.203a.916.916 0 0 1-.206-.