---
layout: base.njk
permalink: "/resume/"
eleventyComputed:
  title: "{{ resume.title }}"
  description: "{{ resume.description | safe }}"

---

<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <!-- Top Action & Download Toolbar -->
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-neutral-200/80 dark:border-neutral-800 print:hidden">
    <div>
      <div class="flex items-center gap-2">
        <a
          href="/"
          class="font-mono text-xs text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition"
        >Home</a>
        <span class="text-neutral-300 dark:text-neutral-700">/</span>
        <span
          class="font-mono text-xs text-neutral-800 dark:text-white font-semibold"
        >Resume</span>
      </div>
      <h1 class="font-heading text-4xl sm:text-5xl font-bold tracking-tight text-neutral-950 dark:text-white mt-1">
        {{ resume.heading }}
      </h1>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 font-sans mt-0.5">
        {{ resume.updated }}{% if resume.availability %} &bull; {{ resume.availability }}{% endif %}
      </p>
    </div>

    <!-- Download & Print Actions -->
    <div class="flex items-center gap-3 shrink-0">
      <button
        type="button"
        onclick="window.print()"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-800 px-4 py-2.5 text-sm font-medium text-neutral-800 dark:text-neutral-200 shadow-2xs hover:bg-neutral-100 dark:hover:bg-neutral-700 transition focus:outline-none"
      >
        <svg
          class="w-4 h-4 text-neutral-600 dark:text-neutral-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2">
          </path>
          <rect width="12" height="8" x="6" y="14"></rect>
        </svg>
        <span>Print / Save</span>
      </button>

      <a
        href="{{ site.resume }}"
        download="Debosmita_Rit_Resume.pdf"
        target="_blank"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-neutral-950 dark:bg-white px-5 py-2.5 text-sm font-semibold text-white dark:text-neutral-950 shadow-sm hover:bg-neutral-800 dark:hover:bg-neutral-200 transition focus:outline-none group"
      >
        <svg
          class="w-4 h-4 transition-transform group-hover:translate-y-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" x2="12" y1="15" y2="3"></line>
        </svg>
        <span>Download PDF</span>
      </a>
    </div>
  </div>

  <!-- Resume Sheet / Printable Paper Canvas -->
  <div class="mx-auto max-w-4xl bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-200/90 dark:border-neutral-800 shadow-sm p-6 sm:p-12 lg:p-14 print:border-none print:shadow-none print:p-0 print:max-w-none print:bg-white print:text-black">
    <!-- Resume Header -->
    <header class="pb-8 border-b border-neutral-200 dark:border-neutral-800">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6">
        <div>
          <div class="flex items-baseline gap-2.5 flex-wrap">
            <h2 class="font-heading text-4xl sm:text-5xl font-bold tracking-tight text-neutral-950 dark:text-white leading-none">
              {{ site.name }}
            </h2>
          </div>
          <p class="font-mono text-sm sm:text-base text-emerald-600 dark:text-emerald-400 font-semibold mt-2 leading-snug">
            {{ site.role }}
          </p>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2.5 max-w-xl leading-relaxed font-sans">
            {{ resume.summary }}
          </p>
        </div>

        <!-- Contact & Meta Column -->
        <div class="shrink-0 space-y-1.5 text-xs font-mono text-neutral-600 dark:text-neutral-400 sm:text-right">
          <div>
            <a
              href="{{ site.github }}"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-black dark:hover:text-white transition"
            >github.com/DebosmitaRit</a>
          </div>
          <div>
            <a
              href="{{ site.linkedin }}"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-black dark:hover:text-white transition"
            >linkedin.com/in/debosmitarit</a>
          </div>
          <div>
            <span class="text-neutral-500 dark:text-neutral-400">{{
              resume.location
            }}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- 1. Education Section -->
    <section class="py-8 border-b border-neutral-200/80 dark:border-neutral-800">
      <div class="flex items-center gap-2 mb-4">
        <span
          class="font-mono text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-bold"
        >01.</span>
        <h3 class="font-heading text-2xl font-bold text-neutral-950 dark:text-white tracking-tight">
          Education
        </h3>
      </div>

      <div class="rounded-xl border border-neutral-100 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-800/40 p-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
          <h4 class="font-heading text-xl font-bold text-neutral-900 dark:text-white">
            {{ resume.education.degree }}
          </h4>
          <span
            class="font-mono text-xs text-neutral-500 dark:text-neutral-400 font-medium"
          >{{ resume.education.period }}</span>
        </div>
        <p class="text-xs font-mono text-neutral-500 dark:text-neutral-400 mt-0.5">
          {{ resume.education.field }}
        </p>
        <div class="mt-3 text-sm text-neutral-700 dark:text-neutral-300 space-y-1 leading-relaxed">
          <p>
            <strong>Core Focus Areas:</strong> {{ resume.education.focus }}
          </p>
          {% if resume.education.distinction %}
            <p class="text-xs text-neutral-600 dark:text-neutral-400 font-mono pt-1">
              {{ resume.education.distinction }}
            </p>
          {% endif %}
        </div>
      </div>
    </section>

    <!-- 2. Technical Competencies & Specializations -->
    <section class="py-8 border-b border-neutral-200/80 dark:border-neutral-800">
      <div class="flex items-center gap-2 mb-5">
        <span
          class="font-mono text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-bold"
        >02.</span>
        <h3 class="font-heading text-2xl font-bold text-neutral-950 dark:text-white tracking-tight">
          Technical &amp; Design Competencies
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        {% for comp in resume.competencies %}
          <div class="rounded-xl border border-neutral-200/80 dark:border-neutral-800 p-4 bg-white dark:bg-neutral-800/40">
            <span
              class="font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider block mb-1.5"
            >
              {{ comp.category }}
            </span>
            <p class="text-neutral-700 dark:text-neutral-300 leading-relaxed">
              {{ comp.details | safe }}
            </p>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- 3. Professional Experience -->
    <section class="py-8 border-b border-neutral-200/80 dark:border-neutral-800">
      <div class="flex items-center gap-2 mb-6">
        <span
          class="font-mono text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-bold"
        >03.</span>
        <h3 class="font-heading text-2xl font-bold text-neutral-950 dark:text-white tracking-tight">
          Professional Experience
        </h3>
      </div>

      <div class="space-y-8">
        {% for job in resume.experience %}
          <div class="relative pl-6 sm:pl-8 {% if not loop.last %}before:absolute before:left-0 before:top-2 before:bottom-0 before:w-0.5 before:bg-neutral-200 dark:before:bg-neutral-800{% endif %}">
            <div class="absolute left-0 top-1.5 w-2 h-2 rounded-full -translate-x-0.75 {% if loop.first %}bg-emerald-600 ring-4 ring-emerald-50 dark:ring-emerald-950{% else %}bg-neutral-400 dark:bg-neutral-600 ring-4 ring-neutral-100 dark:ring-neutral-800{% endif %}">
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <h4 class="font-heading text-xl font-bold text-neutral-950 dark:text-white">
                {{ job.role }}
              </h4>
              <span
                class="font-mono text-xs text-neutral-500 dark:text-neutral-400 font-medium"
              >{{ job.period }}</span>
            </div>
            <p class="font-mono text-xs text-neutral-600 dark:text-neutral-400 mt-0.5">
              {% if job.companyUrl %}
                <a
                  href="{{ job.companyUrl }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-neutral-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 underline underline-offset-2 transition"
                >{{ job.company }}</a>
              {% else %}
                <span class="font-semibold text-neutral-900 dark:text-white">{{ job.company }}</span>
              {% endif %}
              &bull; {{ job.department }}
            </p>

            <ul class="mt-3 space-y-2 text-sm text-neutral-700 dark:text-neutral-300 list-disc list-outside pl-4 leading-relaxed">
              {% for bullet in job.bullets %}
                <li>{{ bullet }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- 4. Industry Certifications & Accreditations -->
    {% if resume.certifications and resume.certifications.length > 0 %}
    <section class="py-8 border-b border-neutral-200/80 dark:border-neutral-800">
      <div class="flex items-center gap-2 mb-6">
        <span
          class="font-mono text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-bold"
        >04.</span>
        <h3 class="font-heading text-2xl font-bold text-neutral-950 dark:text-white tracking-tight">
          Industry Certifications &amp; Accreditations
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {% for cert in resume.certifications %}
          <div class="rounded-xl border border-neutral-200/80 dark:border-neutral-800 bg-white dark:bg-neutral-800/40 p-5 flex flex-col justify-between shadow-2xs hover:border-neutral-300 dark:hover:border-neutral-700 transition">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2 font-mono text-xs">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/70 dark:border-emerald-800 font-semibold text-[11px]">
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="m9 12 2 2 4-4"/>
                  </svg>
                  <span>{{ cert.issuer }}</span>
                </span>
                <span class="text-neutral-500 dark:text-neutral-400 font-medium">Issued {{ cert.issued }}</span>
              </div>

              <h4 class="font-heading text-xl font-bold text-neutral-950 dark:text-white mt-1">
                {{ cert.title }}
              </h4>

              {% if cert.skills %}
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {% for skill in cert.skills %}
                    <span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300">
                      {{ skill }}
                    </span>
                  {% endfor %}
                </div>
              {% endif %}
            </div>

            {% if cert.url %}
              <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-between">
                <a
                  href="{{ cert.url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 group"
                >
                  <span>Verify on Credly</span>
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- 5. Selected Projects & Engineering Highlights -->
    {% if resume.selectedWorks and resume.selectedWorks.length > 0 %}
    <section class="py-8 border-b border-neutral-200/80 dark:border-neutral-800">
      <div class="flex items-center gap-2 mb-5">
        <span
          class="font-mono text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-bold"
        >05.</span>
        <h3 class="font-heading text-2xl font-bold text-neutral-950 dark:text-white tracking-tight">
          Selected Works &amp; Systems
        </h3>
      </div>

      <div class="space-y-4">
        {% for work in resume.selectedWorks %}
          <div class="rounded-xl border border-neutral-200/80 dark:border-neutral-800 bg-white dark:bg-neutral-800/40 p-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <h4 class="font-heading text-lg font-bold text-neutral-900 dark:text-white">
                <a
                  href="{{ work.url }}"
                  class="hover:text-emerald-600 dark:hover:text-emerald-400 transition"
                >{{ work.title }} &rarr;</a>
              </h4>
              <span
                class="font-mono text-xs text-emerald-600 dark:text-emerald-400 font-semibold"
              >{{ work.tags }}</span>
            </div>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-relaxed">
              {{ work.description }}
            </p>
          </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- 6. Honors, Leadership & Interests -->
    <section class="pt-8">
      <div class="flex items-center gap-2 mb-4">
        <span
          class="font-mono text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-bold"
        >06.</span>
        <h3 class="font-heading text-2xl font-bold text-neutral-950 dark:text-white tracking-tight">
          Honors &amp; Leadership
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono">
        {% for honor in resume.honors %}
          <div class="rounded-lg bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200/80 dark:border-neutral-800 p-3">
            <span class="font-bold text-neutral-900 dark:text-white block">{{
              honor.title
            }}</span>
            <span class="text-neutral-500 dark:text-neutral-400 mt-0.5 block">{{
              honor.subtitle
            }}</span>
          </div>
        {% endfor %}
      </div>
    </section>
  </div>
</div>
