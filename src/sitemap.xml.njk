---
permalink: "/sitemap.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.all %}
  {% if item.url and not item.data.eleventyExcludeFromCollections and not ("/admin" in item.url) and not item.data.draft and not (item.url == '/' and home.draft) and not (item.url == '/about/' and about.draft) and not (item.url == '/resume/' and resume.draft) and not (item.url == '/portfolio/' and portfolioPage.draft) and not (item.url == '/blog/' and blogPage.draft) %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <lastmod>{{ item.date | isoDate }}</lastmod>
    <changefreq>{% if item.url == '/' %}weekly{% elif item.url == '/about/' or item.url == '/portfolio/' or item.url == '/resume/' or item.url == '/blog/' %}monthly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if item.url == '/' %}1.0{% elif item.url == '/about/' or item.url == '/portfolio/' or item.url == '/resume/' or item.url == '/blog/' %}0.8{% else %}0.6{% endif %}</priority>
  </url>
  {% endif %}
{% endfor %}
</urlset>
