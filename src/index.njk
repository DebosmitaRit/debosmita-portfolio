.17.012.044.004.092-.004.135.008.06.004.068.036.06.076"/></svg>
                {% elif item.icon == 'code' %}
                  <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                {% else %}
                  <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                {% endif %}
              </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Hero Profile / Visual Graphic -->
      <div class="lg:col-span-4 flex justify-center lg:justify-end">
        <div class="relative">
          <div class="relative overflow-hidden rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-2.5 shadow-sm">
            <img
              src="{{ home.heroImage }}"
              alt="{{ site.name }}"
              class="w-64 h-64 sm:w-72 sm:h-72 object-cover rounded-lg bg-neutral-900"
              loading="eager"
            />
            <div class="mt-2.5 px-1 flex items-center justify-center font-mono text-xs text-neutral-600 dark:text-neutral-400">
              <span class="text-neutral-800 dark:text-white font-semibold">{{
                site.name
              }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. Infinite GSAP Scroll for Languages, Libraries & Frameworks (Technical Gray Ticker Strip) -->
{% include "components/tech-stack-ticker.njk" %}

<!-- 3. Showcase: Portfolio Works Section (Cool Slate Architectural Background) -->
<section
  class="relative w-full bg-[#f4f6fa] dark:bg-neutral-900/60 border-b border-neutral-200/80 dark:border-neutral-800 py-20"
  id="portfolio"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
      <div>
        <span
          class="font-mono text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold"
        >{{ home.portfolioSubheading or "Showcase" }}</span>
        <h2 class="font-heading text-4xl sm:text-5xl font-bold text-neutral-950 dark:text-white mt-1">
          {{ home.portfolioHeading or "Portfolio Works" }}
        </h2>
      </div>
      <a
        href="/portfolio/"
        class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-200 hover:text-neutral-600 dark:hover:text-white inline-flex items-center gap-1.5 group"
      >
        <span>View all portfolio works</span>
        <svg
          class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {% for project in collections.portfolio | reverse | limit(3) %}
        <a
          href="{{ project.url }}"
          class="group relative min-h-105 sm:min-h-115 rounded-2xl overflow-hidden flex flex-col justify-end p-6 sm:p-8 border border-neutral-200/80 dark:border-neutral-800 shadow-xs hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
        >
          <!-- Background Image with smooth hover scale -->
          {% if project.data.image %}
            <img
              src="{{ project.data.image }}"
              alt="{{ project.data.title }}"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          {% endif %}

          <!-- Ambient Gradient Overlay for high-contrast typography -->
          <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/45 to-black/15 group-hover:from-black/95 transition-colors">
          </div>

          <!-- Foreground Content -->
          <div class="relative z-10">
            <div class="flex items-center gap-2 mb-3">
              <span
                class="inline-flex items-center rounded-full bg-white px-3 py-1 text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-900 shadow-xs"
              >
                {{ project.data.client or "Case Study" }}
              </span>
              <span class="font-mono text-xs text-white/75">
                {{ project.data.date | postDate }}
              </span>
            </div>

            <h3 class="font-heading text-3xl sm:text-4xl font-bold text-white! leading-tight group-hover:text-neutral-200! transition-colors">
              {{ project.data.title }}
            </h3>

            <p class="mt-2.5 text-sm text-white/85 font-sans leading-relaxed line-clamp-2">
              {{ project.data.summary }}
            </p>

            <div class="mt-4 flex items-center gap-1.5 font-mono text-xs font-semibold text-white/90 group-hover:text-white transition-colors">
              <span>Explore Case Study</span>
              <svg
                class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
        </a>
      {% else %}
        <div class="md:col-span-3 rounded-2xl border border-dashed border-neutral-300 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/40 p-12 text-center">
          <p class="text-sm font-mono text-neutral-500 dark:text-neutral-400">
            Selected case studies and engineering projects are currently in progress. Please check back soon.
          </p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- 4. Latest Blog Articles Section (Warm Editorial Linen Background) -->
<section
  class="relative w-full bg-[#faf8f5] dark:bg-neutral-950 py-20"
  id="blog"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <h2 class="font-heading text-4xl sm:text-5xl font-bold text-neutral-950 dark:text-white mt-1">
          {{ home.blogHeading or "Recent Articles" }}
        </h2>
      </div>
      <a
        href="/blog/"
        class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-200 hover:text-neutral-600 dark:hover:text-white inline-flex items-center gap-1.5 group"
      >
        <span>View all articles</span>
        <svg
          class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {% for post in collections.blog | reverse | limit(2) %}
        <a
          href="{{ post.url }}"
          class="flex flex-col overflow-hidden rounded-xl border border-neutral-200/90 dark:border-neutral-800 bg-white dark:bg-neutral-900 hover:border-neutral-400 dark:hover:border-neutral-700 transition-colors duration-150 group shadow-xs"
        >
          {% if post.data.image %}
            <div class="aspect-video overflow-hidden bg-neutral-900">
              <img
                src="{{ post.data.image }}"
                alt="{{ post.data.title }}"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          {% endif %}
          <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-neutral-400 dark:text-neutral-500 mb-2">
                <time datetime="{{ post.data.date }}">{{
                  post.data.date | postDate
                }}</time>
                <span
                  class="text-neutral-500 dark:text-neutral-400 font-semibold"
                >Essay</span>
              </div>
              <h3 class="font-heading text-2xl sm:text-3xl font-bold text-neutral-950 dark:text-white group-hover:text-neutral-700 dark:group-hover:text-emerald-400 transition-colors">
                {{ post.data.title }}
              </h3>
              <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400 font-sans leading-relaxed line-clamp-2">
                {{ post.data.description }}
              </p>
            </div>
          </div>
        </a>
      {% else %}
        <div class="md:col-span-2 rounded-2xl border border-dashed border-neutral-300 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/40 p-12 text-center">
          <p class="text-sm font-mono text-neutral-500 dark:text-neutral-400">
            Articles and technical notes are currently being drafted. Please check back soon.
          </p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
