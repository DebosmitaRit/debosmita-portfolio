<!-- GSAP Infinite Scroll Script -->
<script>
  (function() {
    function setupGSAPTechTicker() {
      if (typeof gsap === "undefined") {
        setTimeout(setupGSAPTechTicker, 50);
        return;
      }

      const track = document.getElementById("tech-ticker-track");
      const wrapper = document.getElementById("tech-ticker-wrapper");
      if (!track || !wrapper) return;

      // Duplicate inner HTML to enable seamless infinite scroll loop
      if (!track.dataset.cloned) {
        track.dataset.cloned = "true";
        track.innerHTML += track.innerHTML;
      }

      let tween = null;

      function startAnimation() {
        if (tween) tween.kill();

        // Exact distance of one sequence
        const halfWidth = track.scrollWidth / 2;
        if (halfWidth <= 0) return;

        gsap.set(track, { x: 0 });

        tween = gsap.to(track, {
          x: -halfWidth,
          duration: {{ techStack.speed or 38 }},
          ease: "none",
          repeat: -1,
          overwrite: "auto"
        });
      }

      // Start once fonts and dimensions are ready
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(startAnimation);
      } else {
        startAnimation();
      }

      // Pause on hover, resume on mouse leave
      wrapper.addEventListener("mouseenter", () => {
        if (tween) tween.pause();
      });
      wrapper.addEventListener("mouseleave", () => {
        if (tween) tween.play();
      });

      // Recalculate on window resize
      let resizeTimeout;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(startAnimation, 200);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupGSAPTechTicker);
    } else {
      setupGSAPTechTicker();
    }
  })();
</script>
