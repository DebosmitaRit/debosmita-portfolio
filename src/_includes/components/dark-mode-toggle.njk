<!-- Pines UI Dark Mode Toggle Switch Component (DevDojo) -->
<div x-data="{
    darkMode: false,
    init() {
      this.darkMode = document.documentElement.classList.contains('dark');
      this.$watch('darkMode', val => {
        if (val) {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        }
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { darkMode: val } }));
      });
      window.addEventListener('theme-changed', (e) => {
        if (this.darkMode !== e.detail.darkMode) {
          this.darkMode = e.detail.darkMode;
        }
      });
      window.addEventListener('storage', (e) => {
        if (e.key === 'theme') {
          this.darkMode = e.newValue === 'dark';
        }
      });
    },
    toggle() {
      this.darkMode = !this.darkMode;
    }
  }" 
  class="inline-flex items-center">
  <button 
    type="button" 
    @click="toggle()" 
    :class="darkMode ? 'bg-neutral-800 border-neutral-700 ring-neutral-700' : 'bg-neutral-200 border-neutral-300 ring-neutral-300'"
    class="relative inline-flex h-7 w-12 shrink-0 cursor-pointer rounded-full border p-0.5 transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-neutral-400 focus:ring-offset-2 dark:focus:ring-offset-neutral-950"
    role="switch" 
    :aria-checked="darkMode" 
    aria-label="Toggle color theme"
    title="Toggle dark mode"
    x-cloak>
    <span 
      :class="darkMode ? 'translate-x-5 bg-neutral-950 text-amber-300 border-neutral-700' : 'translate-x-0 bg-white text-neutral-600 border-neutral-200'"
      class="pointer-events-none flex h-5.5 w-5.5 items-center justify-center rounded-full border shadow-xs transition duration-200 ease-in-out">
      <!-- Sun icon (Light mode) -->
      <svg x-show="!darkMode" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
      <!-- Moon icon (Dark mode) -->
      <svg x-show="darkMode" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path>
      </svg>
    </span>
  </button>
</div>
