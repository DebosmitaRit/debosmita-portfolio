<!-- External Link Hovercard Preview Component (Minimal, Crisp & Streamlined) -->
<div 
  id="external-link-hovercard" 
  class="fixed z-50 pointer-events-none opacity-0 transition-opacity duration-150 ease-out will-change-transform"
  style="top: -9999px; left: -9999px;"
  role="tooltip"
  aria-hidden="true"
>
  <div class="inline-flex items-center gap-3 rounded-2xl border border-neutral-200/90 dark:border-neutral-800 bg-white/95 dark:bg-neutral-900/95 backdrop-blur-md px-3.5 py-2.5 shadow-xl ring-1 ring-black/5 dark:ring-white/10 text-neutral-900 dark:text-neutral-100">
    <!-- Favicon / Brand Icon Container (Enlarged) -->
    <div class="w-9 h-9 rounded-xl bg-neutral-100 dark:bg-neutral-800 border border-neutral-200/80 dark:border-neutral-700/80 flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
      <div id="hovercard-custom-icon" class="flex items-center justify-center w-full h-full"></div>
      <img id="hovercard-favicon" src="" alt="" class="w-6 h-6 object-contain hidden" />
      <svg id="hovercard-fallback" class="w-5 h-5 text-neutral-400 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
    </div>

    <!-- Clean Brand Title (Says 'LinkedIn', 'GitHub', etc. that's all) -->
    <span id="hovercard-title" class="font-heading text-base font-semibold text-neutral-950 dark:text-white pr-0.5 tracking-tight">LinkedIn</span>

    <!-- External Arrow Icon -->
    <svg class="w-3.5 h-3.5 text-neutral-400 dark:text-neutral-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="7" y1="17" x2="17" y2="7"></line>
      <polyline points="7 7 17 7 17 17"></polyline>
    </svg>
  </div>
</div>

<script>
  (function() {
    var hovercard = document.getElementById('external-link-hovercard');
    if (!hovercard) return;

    var customIconEl = document.getElementById('hovercard-custom-icon');
    var faviconEl = document.getElementById('hovercard-favicon');
    var fallbackEl = document.getElementById('hovercard-fallback');
    var titleEl = document.getElementById('hovercard-title');

    var currentAnchor = null;
    var enterTimer = null;
    var leaveTimer = null;

    var brandNames = {
      'linkedin.com': 'LinkedIn',
      'github.com': 'GitHub',
      'twitter.com': 'Twitter',
      'x.com': 'Twitter',
      '11ty.dev': 'Eleventy',
      'tailwindcss.com': 'Tailwind CSS',
      'alpinejs.dev': 'Alpine.js',
      'figma.com': 'Figma'
    };

    var brandIcons = {
      'linkedin.com': '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><rect width="24" height="24" rx="4" fill="#0A66C2"/><path d="M7.86 6.54a1.64 1.64 0 1 1-3.28 0 1.64 1.64 0 0 1 3.28 0ZM4.58 19.27h3.28V9.12H4.58v10.15ZM19.42 19.27h-3.27v-5.13c0-1.22-.02-2.8-1.7-2.8-1.71 0-1.97 1.33-1.97 2.71v5.22H9.21V9.12h3.14v1.39h.04c.44-.83 1.51-1.7 3.1-1.7 3.32 0 3.93 2.18 3.93 5.02v5.44Z" fill="#FFFFFF"/></svg>',
      'github.com': '<svg class="w-6 h-6 text-neutral-900 dark:text-white" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>',
      'twitter.com': '<svg class="w-5 h-5 text-neutral-900 dark:text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
      'x.com': '<svg class="w-5 h-5 text-neutral-900 dark:text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>'
    };

    // Filter out internal links and links inside dropdowns/navigation
    function isExternalLink(a) {
      if (!a.href || a.getAttribute('href').startsWith('#') || a.getAttribute('href').startsWith('javascript:')) {
        return false;
      }
      if (a.hasAttribute('data-no-hovercard')) {
        return false;
      }
      
      // Do not show hovercards on links under dropdowns, navigation headers, or drawers
      if (
        a.closest('header') || 
        a.closest('nav') || 
        a.closest('[role="menu"]') || 
        a.closest('[data-dropdown]') || 
        a.closest('.dropdown') || 
        a.closest('[x-ref="navContainer"]')
      ) {
        return false;
      }

      try {
        var url = new URL(a.href, window.location.href);
        var isHttp = url.protocol === 'http:' || url.protocol === 'https:';
        var isDifferentHost = url.hostname !== window.location.hostname;
        var notLocal = url.hostname !== 'localhost' && url.hostname !== '127.0.0.1';
        return isHttp && (isDifferentHost || a.getAttribute('target') === '_blank') && notLocal;
      } catch (e) {
        return false;
      }
    }

    function positionCard(anchorEl) {
      var rect = anchorEl.getBoundingClientRect();
      var card = hovercard.firstElementChild;
      var cardWidth = card.offsetWidth || 140;
      var cardHeight = card.offsetHeight || 44;

      // Vertical: Prefer above the anchor, fallback to below
      var top;
      if (rect.top - cardHeight - 8 > 8) {
        top = rect.top - cardHeight - 8;
      } else {
        top = rect.bottom + 8;
      }

      // Horizontal: Center over anchor
      var left = rect.left + (rect.width / 2) - (cardWidth / 2);
      var minLeft = 12;
      var maxLeft = window.innerWidth - cardWidth - 12;
      left = Math.max(minLeft, Math.min(left, maxLeft));

      hovercard.style.top = Math.round(top) + 'px';
      hovercard.style.left = Math.round(left) + 'px';
    }

    function showCard(anchorEl) {
      currentAnchor = anchorEl;
      try {
        var url = new URL(anchorEl.href);
        var host = url.hostname.replace(/^www\./, '').toLowerCase();

        // Get clean brand title (e.g. "LinkedIn")
        var title = brandNames[host];
        if (!title) {
          var aria = anchorEl.getAttribute('aria-label');
          if (aria && aria.indexOf('Profile') !== -1) {
            title = aria.replace(/\s*Profile/i, '').trim();
          } else {
            var parts = host.split('.');
            var name = parts.length > 1 ? parts[parts.length - 2] : host;
            title = name.charAt(0).toUpperCase() + name.slice(1);
          }
        }
        titleEl.textContent = title;

        // Custom crisp brand icon or high-res favicon
        if (brandIcons[host]) {
          customIconEl.innerHTML = brandIcons[host];
          customIconEl.style.display = 'flex';
          faviconEl.style.display = 'none';
          if (fallbackEl) fallbackEl.style.display = 'none';
        } else {
          customIconEl.innerHTML = '';
          customIconEl.style.display = 'none';
          faviconEl.style.display = 'block';
          if (fallbackEl) fallbackEl.style.display = 'none';

          faviconEl.onerror = function() {
            faviconEl.style.display = 'none';
            if (fallbackEl) fallbackEl.style.display = 'block';
          };
          faviconEl.src = 'https://www.google.com/s2/favicons?domain=' + encodeURIComponent(host) + '&sz=64';
        }

        positionCard(anchorEl);
        hovercard.classList.remove('opacity-0');
        hovercard.classList.add('opacity-100');
        hovercard.setAttribute('aria-hidden', 'false');
      } catch (err) {
        // Ignore invalid URL errors
      }
    }

    function hideCard() {
      hovercard.classList.add('opacity-0');
      hovercard.classList.remove('opacity-100');
      hovercard.setAttribute('aria-hidden', 'true');
      currentAnchor = null;
    }

    function scheduleShow(anchorEl) {
      clearTimeout(leaveTimer);
      clearTimeout(enterTimer);
      enterTimer = setTimeout(function() {
        showCard(anchorEl);
      }, 100);
    }

    function scheduleHide() {
      clearTimeout(enterTimer);
      clearTimeout(leaveTimer);
      leaveTimer = setTimeout(function() {
        hideCard();
      }, 80);
    }

    // Document-level delegation for hover events
    document.addEventListener('mouseover', function(e) {
      var anchor = e.target.closest('a');
      if (anchor && isExternalLink(anchor)) {
        scheduleShow(anchor);
      }
    });

    document.addEventListener('mouseout', function(e) {
      var anchor = e.target.closest('a');
      if (anchor && isExternalLink(anchor)) {
        scheduleHide();
      }
    });

    // Dismiss on scroll or Escape key
    window.addEventListener('scroll', function() {
      if (currentAnchor) {
        hideCard();
      }
    }, { passive: true });

    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        hideCard();
      }
    });
  })();
</script>
