---
layout: base.njk
permalink: "/about/"
eleventyComputed:
  title: "{{ about.title }}"
  description: "{{ about.description | safe }}"

---

<article class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <!-- Breadcrumbs -->
  <nav
    aria-label="Breadcrumb"
    class="mb-6 flex items-center gap-2 text-xs font-mono text-neutral-500 dark:text-neutral-400"
  >
    <a href="/" class="hover:text-black dark:hover:text-white transition"
    >Home</a>
    <span class="text-neutral-300 dark:text-neutral-700">/</span>
    <span class="text-neutral-800 dark:text-white font-semibold">{{
      about.title
    }}</span>
  </nav>

  <!-- Page Header Title -->
  <header class="mb-10 pb-8 border-b border-neutral-200 dark:border-neutral-800">
    <h1 class="font-heading text-5xl sm:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white">
      {{ about.title }}
    </h1>
    <p class="mt-4 text-xl text-neutral-600 dark:text-neutral-400 font-sans leading-relaxed">
      {{ about.description }}
    </p>
  </header>

  <!-- Profile Header Card -->
  <div class="mb-14 rounded-2xl border border-neutral-200/90 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-6 sm:p-10 shadow-xs flex flex-col md:flex-row items-center gap-8 transition-colors">
    <div class="shrink-0 relative group">
      <div class="absolute -inset-1 rounded-2xl bg-linear-to-tr from-emerald-500/20 to-neutral-500/10 blur-xs transition-opacity group-hover:opacity-100 opacity-60">
      </div>
      <img
        src="{{ about.profileImage }}"
        alt="Debosmita Rit"
        class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-xl object-cover border border-neutral-300 dark:border-neutral-700 shadow-sm"
      />
    </div>
    <div class="flex-1 text-center md:text-left">
      {% if about.statusBadge or about.statusLocation %}
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-2">
        {% if about.statusBadge %}
        <span
          class="font-mono text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-semibold bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/60 dark:border-emerald-800/60 rounded px-2.5 py-0.5"
        >{{ about.statusBadge }}</span>
        {% endif %}
        {% if about.statusLocation %}
        <span
          class="font-mono text-xs text-neutral-500 dark:text-neutral-400"
        >{{ about.statusLocation }}</span>
        {% endif %}
      </div>
      {% endif %}
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-neutral-950 dark:text-white leading-tight">
        {{ about.headline }}
      </h2>
      <p class="mt-2.5 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 font-sans leading-relaxed">
        {{ about.bioShort }}
      </p>
      <div class="mt-5 flex flex-wrap items-center justify-center md:justify-start gap-2.5">
        <a
          href="{{ site.github }}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 px-3 py-1.5 text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700 hover:text-black dark:hover:text-white hover:border-neutral-300 dark:hover:border-neutral-600 transition shadow-2xs no-underline"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            />
          </svg>
          <span>GitHub</span>
        </a>
        <a
          href="{{ site.linkedin }}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 px-3 py-1.5 text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700 hover:text-[#0077b5] dark:hover:text-[#38bdf8] hover:border-neutral-300 dark:hover:border-neutral-600 transition shadow-2xs no-underline"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37h2.8V10.9h-2.8M7.86 6.54a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28Z" />
          </svg>
          <span>LinkedIn</span>
        </a>
        <a
          href="{{ site.twitter }}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 px-3 py-1.5 text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700 hover:text-black dark:hover:text-white hover:border-neutral-300 dark:hover:border-neutral-600 transition shadow-2xs no-underline"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          <span>Twitter</span>
        </a>
        <a
          href="{{ site.resume }}"
          download="Debosmita_Rit_Resume.pdf"
          class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 px-3 py-1.5 text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-neutral-300 dark:hover:border-neutral-600 transition shadow-2xs no-underline"
        >
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" x2="12" y1="15" y2="3"></line>
          </svg>
          <span>CV / Resume</span>
        </a>
      </div>
    </div>
  </div>

  <!-- At a Glance Metric Highlights -->
  {% if about.metrics and about.metrics.length > 0 %}
  <section class="mb-16">
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {% for metric in about.metrics %}
        <div class="rounded-xl border border-neutral-200/90 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-5 text-center shadow-xs">
          <div class="font-heading text-4xl sm:text-5xl font-bold {% if loop.index == 2 %}text-emerald-600 dark:text-emerald-400{% else %}text-neutral-950 dark:text-white{% endif %}">
            {{ metric.value }}
          </div>
          <div class="mt-1 font-mono text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">
            {{ metric.label }}
          </div>
        </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- Biography & Journey -->
  <section class="mb-16">
    <h2 class="font-heading text-3xl font-bold text-neutral-950 dark:text-white mb-6">
      {{ about.journeyHeadline }}
    </h2>
    <div class="space-y-5 text-base sm:text-lg text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans">
      {% for para in about.journeyParagraphs %}
        <p>{{ (para.paragraph if para.paragraph else (para.para if para.para else para)) | safe }}</p>
      {% endfor %}
    </div>
  </section>

  <!-- Career Experience Timeline -->
  <section class="mb-16" id="experience">
    <div class="flex items-center justify-between mb-6">
      <h2 class="font-heading text-3xl font-bold text-neutral-950 dark:text-white">
        Career Milestones
      </h2>
      <span
        class="font-mono text-xs text-neutral-400 uppercase tracking-widest hidden sm:inline"
      >Track Record</span>
    </div>
    <div class="space-y-6">
      {% for job in about.experience %}
        <div class="rounded-xl border border-neutral-200/90 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-6 sm:p-7 shadow-xs transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
            <h3 class="font-heading text-2xl font-bold text-neutral-950 dark:text-white">
              {{ job.role }}
            </h3>
            <span
              class="font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/60 dark:border-emerald-800/60 rounded px-2.5 py-0.5 w-max"
            >{{ job.period }}</span>
          </div>
          <p class="font-mono text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider mb-3">
            {{ job.company }}
          </p>
          <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 font-sans leading-relaxed mb-4">
            {{ job.description }}
          </p>
          {% if job.tags %}
            <div class="flex flex-wrap gap-1.5">
              {% for tag in job.tags %}
                <span
                  class="inline-flex items-center rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-800/60 px-2.5 py-0.5 font-mono text-[11px] text-neutral-600 dark:text-neutral-400"
                >
                  {{ tag }}
                </span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </section>

  <!-- Academic Background -->
  <section class="mb-16">
    <h2 class="font-heading text-3xl font-bold text-neutral-950 dark:text-white mb-6">
      Academic Background
    </h2>
    <div class="rounded-xl border border-neutral-200/90 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-6 sm:p-7 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
        <h3 class="font-heading text-2xl font-bold text-neutral-950 dark:text-white">
          {{ about.academic.degree }}
        </h3>
        <span
          class="font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/60 dark:border-emerald-800/60 rounded px-2.5 py-0.5 w-max"
        >{{ about.academic.period }}</span>
      </div>
      <p class="font-mono text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-wider mb-3">
        {{ about.academic.field }}
      </p>
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 font-sans leading-relaxed">
        {{ about.academic.description }}
      </p>
    </div>
  </section>

  <!-- What I'm Doing Now (Now Page Section) -->
  <section class="mb-16">
    <div class="rounded-2xl border border-neutral-200/90 dark:border-neutral-800 bg-neutral-100/50 dark:bg-neutral-900/40 p-6 sm:p-8">
      <div class="mb-3">
        <h3 class="font-heading text-2xl font-bold text-neutral-950 dark:text-white">
          {{ about.exploring.title }}
        </h3>
      </div>
      <p class="text-xs font-mono text-neutral-500 dark:text-neutral-400 uppercase tracking-wider mb-4">
        {{ about.exploring.updated }}
      </p>
      <ul class="space-y-3 text-sm sm:text-base text-neutral-700 dark:text-neutral-300 font-sans">
        {% for item in about.exploring.items %}
          <li class="flex items-start gap-2.5">
            <span
              class="font-mono text-emerald-600 dark:text-emerald-400 shrink-0 font-bold"
            >&rarr;</span>
            <span>{{ (item.item if item.item else item) | safe }}</span>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
</article>
