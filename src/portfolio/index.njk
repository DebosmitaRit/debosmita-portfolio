---
layout: base.njk
permalink: "/portfolio/"
eleventyComputed:
  title: "{{ portfolioPage.title }}"
  description: "{{ portfolioPage.description }}"
---

<div
  x-data="{
    query: '',
    matches(el) {
      if (!this.query.trim()) return true;
      var q = this.query.toLowerCase().trim();
      var text = el.getAttribute('data-search') || '';
      return text.includes(q);
    },
    get visibleCount() {
      if (!this.query.trim()) return -1;
      var q = this.query.toLowerCase().trim();
      var items = this.$refs.list ? this.$refs.list.querySelectorAll('[data-search-item]') : [];
      var count = 0;
      items.forEach(function(el) {
        if ((el.getAttribute('data-search') || '').includes(q)) count++;
      });
      return count;
    }
  }"
  @keydown.window="if ($event.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) { $event.preventDefault(); $refs.searchInput.focus(); }"
  class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"
>
  <!-- Breadcrumbs -->
  <nav
    aria-label="Breadcrumb"
    class="mb-6 flex items-center gap-2 text-xs font-mono text-neutral-500 dark:text-neutral-400"
  >
    <a href="/" class="hover:text-black dark:hover:text-white transition">Home</a>
    <span class="text-neutral-300 dark:text-neutral-700">/</span>
    <span class="text-neutral-800 dark:text-white font-semibold">Portfolio</span>
  </nav>

  <!-- Page Header -->
  <header class="mb-8 sm:mb-10">
    <h1 class="font-heading text-5xl sm:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white leading-none">
      {{ portfolioPage.heading or "Selected Projects" }}
    </h1>
    <p class="mt-3 text-lg sm:text-xl text-neutral-500 dark:text-neutral-400 font-sans">
      {{ portfolioPage.description }}
    </p>
  </header>

  {% if collections.portfolio.length == 0 %}
    <!-- Clean Empty State when no projects exist yet -->
    <div class="my-12 rounded-2xl border border-dashed border-neutral-300 dark:border-neutral-800 bg-white/60 dark:bg-neutral-900/40 p-12 sm:p-16 text-center">
      <div class="mx-auto w-14 h-14 rounded-2xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-400 dark:text-neutral-500 mb-4 shadow-2xs">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
      </div>
      <h2 class="font-heading text-2xl font-bold text-neutral-900 dark:text-white">
        Selected Projects in Progress
      </h2>
      <p class="mt-2 text-sm sm:text-base text-neutral-500 dark:text-neutral-400 font-sans max-w-md mx-auto leading-relaxed">
        Interactive case studies and engineering systems are currently being documented. Please check back soon!
      </p>
      <div class="mt-6 flex items-center justify-center">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-800 px-5 py-2.5 text-xs font-mono font-medium text-neutral-800 dark:text-neutral-200 shadow-2xs hover:bg-neutral-50 dark:hover:bg-neutral-700 transition"
        >
          <span>&larr; Return Home</span>
        </a>
      </div>
    </div>
  {% else %}
    <!-- Interactive Search Bar & Filter Controls -->
    <div class="mb-10">
      <div class="relative max-w-xl">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-400 dark:text-neutral-500">
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input
          x-ref="searchInput"
          x-model="query"
          type="search"
          placeholder="Search projects by client, role, tech, or #tag..."
          class="w-full rounded-xl border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 py-2.5 pl-10 pr-20 text-sm text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-500 shadow-2xs focus:border-neutral-900 dark:focus:border-white focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:focus:ring-white transition-colors"
        />
        <!-- Keyboard Shortcut Hint / Clear Button -->
        <div class="absolute inset-y-0 right-0 flex items-center pr-2.5">
          <button
            x-show="query.length > 0"
            @click="query = ''; $refs.searchInput.focus()"
            type="button"
            class="rounded-md p-1 text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition"
            aria-label="Clear search"
            style="display: none;"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
          <span
            x-show="!query.length"
            class="hidden sm:inline-flex items-center rounded border border-neutral-200 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 px-1.5 py-0.5 font-mono text-[10px] text-neutral-500 dark:text-neutral-400"
          >
            /
          </span>
        </div>
      </div>

      <!-- Live Search Result Count -->
      <div
        x-show="query.trim().length > 0"
        class="mt-3 flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-neutral-400"
        style="display: none;"
      >
        <span
          x-text="visibleCount === 1 ? '1 project found' : visibleCount + ' projects found'"
        ></span>
        <button
          @click="query = ''"
          class="hover:text-black dark:hover:text-white underline underline-offset-2"
        >
          Reset search
        </button>
      </div>
    </div>

    <!-- Simple List of Portfolio Projects -->
    <div
      x-ref="list"
      class="divide-y divide-neutral-200/80 dark:divide-neutral-800 border-y border-neutral-200/80 dark:border-neutral-800"
    >
      {% for project in collections.portfolio | reverse %}
        <a
          data-search-item
          data-search="{{ (project.data.title or '') | lower }} {{ (project.data.summary or '') | lower }} {{ (project.data.client or '') | lower }} {{ (project.data.role or '') | lower }} {% for tag in project.data.tags %}{{ tag | lower }} {% endfor %}"
          x-show="matches($el)"
          x-transition.opacity.duration.150ms
          href="{{ project.url }}"
          class="group flex flex-col sm:flex-row sm:items-center justify-between py-6 px-3 -mx-3 rounded-lg hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-colors duration-150 gap-3 sm:gap-6"
        >
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2.5 mb-1.5 font-mono text-xs">
              <time
                datetime="{{ project.data.date }}"
                class="text-neutral-400 dark:text-neutral-500 tabular-nums w-28 shrink-0"
              >
                {{ project.data.date | postDate }}
              </time>
              {% if project.data.client %}
                <svg
                  class="w-1.5 h-1.5 fill-neutral-300 dark:fill-neutral-600 shrink-0"
                  viewBox="0 0 6 6"
                >
                  <circle cx="3" cy="3" r="3" />
                </svg>
                <span
                  class="font-semibold text-neutral-700 dark:text-neutral-300 truncate"
                >
                  {{ project.data.client }}
                </span>
              {% endif %}
            </div>

            <h2 class="font-heading text-2xl sm:text-3xl font-bold text-neutral-950 dark:text-white group-hover:text-neutral-700 dark:group-hover:text-emerald-400 transition-colors">
              {{ project.data.title }}
            </h2>

            {% if project.data.summary %}
              <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400 font-sans line-clamp-1">
                {{ project.data.summary }}
              </p>
            {% endif %}
          </div>

          <div class="flex items-center gap-3 shrink-0">
            {% if project.data.role %}
              <span
                class="hidden md:inline-block font-mono text-xs text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800 rounded px-2.5 py-1"
              >
                {{ project.data.role }}
              </span>
            {% endif %}
            <div class="text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-900 dark:group-hover:text-white transition-colors">
              <svg
                class="w-4 h-4 transition-transform group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>

    <!-- Empty State when 0 search results -->
    <div
      x-show="query.trim().length > 0 && visibleCount === 0"
      class="py-16 text-center"
      style="display: none;"
    >
      <div class="mx-auto w-12 h-12 rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-400 dark:text-neutral-500 mb-3">
        <svg
          class="w-6 h-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <p class="font-heading text-xl font-bold text-neutral-900 dark:text-white">
        No projects found
      </p>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400 font-sans max-w-sm mx-auto">
        No projects matched your query "<span
          x-text="query"
          class="font-semibold text-neutral-800 dark:text-neutral-200"
        ></span>". Try another client, role, or technology keyword.
      </p>
      <button
        type="button"
        @click="query = ''; $refs.searchInput.focus()"
        class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-800 px-3.5 py-1.5 text-xs font-medium text-neutral-800 dark:text-neutral-200 shadow-2xs hover:bg-neutral-50 dark:hover:bg-neutral-700 transition"
      >
        Clear search
      </button>
    </div>
  {% endif %}
</div>
